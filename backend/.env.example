# Copy to .env and fill in. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/ecom
DB_USERNAME=ecom
DB_PASSWORD=change-me-to-a-long-random-value

# HS256 signing secret, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: creates the first ADMIN on startup if no admin exists yet (password >= 12 chars)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# true only in dev: exposes /v3/api-docs and /swagger-ui
API_DOCS_ENABLED=false

# Separation of duties: strict (default) or small-team (one person may do several steps with a recorded reason)
SOD_MODE=strict
