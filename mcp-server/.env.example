# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Where the backend listens. Only matters at all when ECOM_OPENAPI_SOURCE=live
# (dev) and for every actual tool call (always). The dev default assumes
# `mvn spring-boot:run` on this machine; point it at a real deployment for
# anything else.
ECOM_API_BASE_URL=http://localhost:8080

# A scoped API key for THIS agent, not a human password. Create it once:
#   1. Sign in as the human this agent acts on behalf of (frontend or API).
#   2. POST /api/v1/api-keys (createApiKey) with only the scopes the agent
#      needs — e.g. ["cart:read","cart:write","orders:read","orders:write"]
#      for a shopping assistant, never more than that person's own role grants.
#   3. The raw key is shown exactly once in the response. Paste it here.
# The backend's own SPEC.md "MCP-readiness contract" describes this flow.
ECOM_API_KEY=ek_replace-with-a-real-scoped-key

# How long to wait for one backend call before giving up.
ECOM_REQUEST_TIMEOUT_SECONDS=30

# Where the backend publishes its OpenAPI document (must be started with
# API_DOCS_ENABLED=true — see backend/SPEC.md "Run"). Only read when
# ECOM_OPENAPI_SOURCE=live, or by scripts/refresh_openapi_cache.py.
ECOM_OPENAPI_PATH=/v3/api-docs

# "cached" (default, and the only mode production should use): tools are
# generated from a committed, reviewed snapshot (ECOM_OPENAPI_CACHE_FILE),
# never from whatever the backend happens to be running right now — a backend
# change must never silently change what an agent can do with no review gate.
# "live": fetch straight from the running backend on every start. Dev only —
# lets you try out a new/changed endpoint before committing a refreshed
# snapshot (scripts/refresh_openapi_cache.py + scripts/diff_openapi_tools.py).
ECOM_OPENAPI_SOURCE=cached

# Required when ECOM_OPENAPI_SOURCE=cached: the committed snapshot's path.
# Suggested: openapi/snapshot.json (commit it once git is allowed).
ECOM_OPENAPI_CACHE_FILE=openapi/snapshot.json

# Name shown to MCP clients (Claude Desktop, Claude Code, etc.).
ECOM_MCP_SERVER_NAME=E-Com

# --- Shared-server (http) mode: simulate a hosted MCP server --------------------------------------
# Default is "stdio": the client launches this server and it holds ONE key (ECOM_API_KEY above).
# Set to "http" to run it as a standalone server the client connects to by URL instead. In http mode
# the server holds NO key (leave ECOM_API_KEY empty - the server refuses to start if it is set):
# every caller sends their own in the X-API-Key header and gets their own tool list.
#   ECOM_MCP_TRANSPORT=http ECOM_API_KEY= uv run python -m ecom_mcp.server
ECOM_MCP_TRANSPORT=stdio
ECOM_MCP_HOST=127.0.0.1
ECOM_MCP_PORT=8000
